---
import site from '@/data/site.json';
import { withBase } from '@/lib/urls';

const links = [
  { href: '/', label: 'Home' },
  { href: '/our-pack/', label: 'Our Pack' },
  { href: '/calendar/', label: 'Calendar' },
  { href: '/join/', label: 'Join' },
  { href: '/new-families/', label: 'New Families' },
  { href: '/resources/', label: 'Resources' },
  { href: '/updates/', label: 'Updates' },
];
const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={withBase('/')} aria-label={`${site.name} home`}>
      <img src={withBase('/pack133.jpg')} width="52" height="52" alt="" />
      <span>
        <strong>{site.name}</strong>
        <small>{site.location}</small>
      </span>
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-button>
      <span class="sr-only">Toggle navigation</span>
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="Main navigation" data-nav>
      {links.map((link) => {
        const href = withBase(link.href);
        const active = link.href === '/'
          ? pathname === href
          : pathname.startsWith(href);
        return <a href={href} aria-current={active ? 'page' : undefined}>{link.label}</a>;
      })}
    </nav>
  </div>
</header>
