---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { formatPublishDate } from '@/lib/dates';
import { withBase } from '@/lib/urls';

export async function getStaticPaths() {
  const updates = await getCollection('updates', ({ data }) => !data.draft);
  return updates.map((update) => ({ params: { id: update.id }, props: { update } }));
}

const { update } = Astro.props;
const { Content } = await render(update);
---

<BaseLayout title={update.data.title} description={update.data.description}>
  <PageHero eyebrow={formatPublishDate(update.data.publishDate)} title={update.data.title} description={update.data.description} />
  <article class="prose page-shell section-space"><Content /></article>
  <div class="page-shell article-back"><a class="text-link" href={withBase('/updates/')}>← All pack updates</a></div>
</BaseLayout>
